{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {"contentSize":"800px","wideSize":"1280px"},
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {"slug":"ink","color":"#0B1720","name":"Ink"},
        {"slug":"ink-soft","color":"#34454F","name":"Ink Soft"},
        {"slug":"muted","color":"#6B7780","name":"Muted"},
        {"slug":"surface","color":"#F7F5F0","name":"Surface"},
        {"slug":"surface-strong","color":"#EEEAE1","name":"Surface Strong"},
        {"slug":"white","color":"#FFFFFF","name":"White"},
        {"slug":"brand","color":"#1F6F5C","name":"Brand"},
        {"slug":"brand-dark","color":"#145244","name":"Brand Dark"},
        {"slug":"brand-soft","color":"#E7F0EC","name":"Brand Soft"},
        {"slug":"sand","color":"#D8C7A2","name":"Sand"},
        {"slug":"border","color":"#E2E0D9","name":"Border"},
        {"slug":"border-strong","color":"#C9C5BA","name":"Border Strong"},
        {"slug":"success","color":"#067647","name":"Success"},
        {"slug":"warning","color":"#B54708","name":"Warning"},
        {"slug":"danger","color":"#B42318","name":"Danger"}
      ],
      "gradients":[]
    },
    "spacing": {
      "blockGap": true,
      "spacingSizes": [
        {"slug":"0","size":"0","name":"None"},
        {"slug":"xs","size":"0.5rem","name":"Extra Small"},
        {"slug":"sm","size":"0.75rem","name":"Small"},
        {"slug":"md","size":"1rem","name":"Medium"},
        {"slug":"lg","size":"1.5rem","name":"Large"},
        {"slug":"xl","size":"2.5rem","name":"Extra Large"},
        {"slug":"2xl","size":"4rem","name":"2X Large"},
        {"slug":"3xl","size":"6rem","name":"3X Large"},
        {"slug":"4xl","size":"8rem","name":"4X Large"}
      ]
    },
    "typography": {
      "dropCap": false,
      "fontFamilies":[
        {"fontFamily":"Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif","slug":"sans","name":"Interface Sans"},
        {"fontFamily":"Georgia, \"Times New Roman\", serif","slug":"serif","name":"Editorial Serif"}
      ],
      "fontSizes":[
        {"slug":"xs","size":"0.75rem","name":"Extra Small"},
        {"slug":"sm","size":"0.875rem","name":"Small"},
        {"slug":"md","size":"1rem","name":"Medium"},
        {"slug":"lg","size":"1.2rem","name":"Large"},
        {"slug":"xl","size":"1.6rem","name":"Extra Large"},
        {"slug":"2xl","size":"2.35rem","name":"2X Large"},
        {"slug":"3xl","size":"clamp(3.25rem, 7vw, 6.5rem)","name":"3X Large"}
      ],
      "fontWeight": true,
      "letterSpacing": true
    },
    "border":{"radius":{"none":"0","sm":"12px","md":"18px","lg":"28px","pill":"999px"}},
    "shadow":{"soft":"0 16px 40px rgba(11,23,32,0.08)","card":"0 10px 30px rgba(11,23,32,0.08)","float":"0 24px 60px rgba(11,23,32,0.14)"}
  },
  "styles":{
    "color":{"background":"var:preset|color|white","text":"var:preset|color|ink"},
    "spacing":{"blockGap":"0","padding":{"top":"0","bottom":"0","left":"24px","right":"24px"}},
    "typography":{"fontFamily":"var:preset|font-family|sans","fontSize":"var:preset|font-size|md","lineHeight":"1.6"},
    "elements":{
      "heading":{"color":{"text":"var:preset|color|ink"},"typography":{"fontWeight":"650","lineHeight":"1.06","letterSpacing":"-0.03em"}},
      "link":{"color":{"text":"var:preset|color|brand"},"typography":{"textDecoration":"none"}},
      "button":{"border":{"radius":"var:preset|border-radius|pill"},"spacing":{"padding":{"top":"0.85rem","bottom":"0.85rem","left":"1.4rem","right":"1.4rem"}},"typography":{"fontWeight":"650"}},
      "input":{"border":{"radius":"var:preset|border-radius|md","color":"var:preset|color|border"},"spacing":{"padding":{"top":"0.9rem","bottom":"0.9rem","left":"1rem","right":"1rem"}}},
      "textarea":{"border":{"radius":"var:preset|border-radius|md","color":"var:preset|color|border"},"spacing":{"padding":{"top":"0.9rem","bottom":"0.9rem","left":"1rem","right":"1rem"}}}
    },
    "blocks":{
      "core/button":{"color":{"background":"var:preset|color|brand","text":"var:preset|color|white"}},
      "core/navigation":{"typography":{"fontSize":"var:preset|font-size|sm","fontWeight":"600"}},
      "core/image":{"border":{"radius":"var:preset|border-radius|md"}},
      "core/separator":{"color":{"background":"var:preset|color|border"}}
    }
  },
  "templateParts":[{"name":"header","title":"Header","area":"header"},{"name":"footer","title":"Footer","area":"footer"}],
  "customTemplates":[]
}